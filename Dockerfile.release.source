# Go version is pinned to an exact patch release: official golang images set
# GOTOOLCHAIN=local, so the toolchain directive in go.mod is ignored and the
# image tag alone decides which stdlib (and its CVE fixes) ends up in the binary.
FROM golang:1.26.11-alpine AS build

ARG TARGETARCH
ARG RELEASE

ENV GOPATH=/go
ENV CGO_ENABLED=0

WORKDIR /build

# Install build dependencies
RUN apk add -U --no-cache ca-certificates git

# Build minio from source (prebuilt binaries are no longer published on dl.min.io)
ARG COMMIT_ID
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN VERSION=$(echo "${RELEASE}" | sed -E 's#RELEASE\.([0-9]+)-([0-9]+)-([0-9]+)T([0-9]+)-([0-9]+)-([0-9]+)Z#\1-\2-\3T\4:\5:\6Z#') && \
    YEAR=$(echo "${RELEASE}" | sed -E 's#RELEASE\.([0-9]{4}).*#\1#') && \
    GOOS=linux GOARCH=${TARGETARCH} go build -tags kqueue -trimpath -o /go/bin/minio \
      -ldflags "-s -w \
        -X github.com/minio/minio/cmd.Version=${VERSION} \
        -X github.com/minio/minio/cmd.CopyrightYear=${YEAR} \
        -X github.com/minio/minio/cmd.ReleaseTag=${RELEASE} \
        -X github.com/minio/minio/cmd.CommitID=${COMMIT_ID} \
        -X github.com/minio/minio/cmd.ShortCommitID=$(echo ${COMMIT_ID} | cut -c1-12) \
        -X github.com/minio/minio/cmd.GOPATH=${GOPATH}"

# Build mc client from source at a pinned version. mc is no longer maintained
# upstream and its go.mod pins vulnerable dependencies, so `go install mc@latest`
# would ship them. Bump the vulnerable modules to the same versions minio uses.
ARG MC_VERSION=v0.0.0-20251106162529-77f82e18b540
ARG MC_DEP_UPGRADES="golang.org/x/crypto@v0.59.0 golang.org/x/net@v0.62.0 golang.org/x/sys@v0.50.0 golang.org/x/text@v0.44.0 google.golang.org/grpc@v1.83.2 github.com/klauspost/compress@v1.20.5 github.com/prometheus/prometheus@v0.311.3 go.etcd.io/etcd/api/v3@v3.5.36 go.etcd.io/etcd/client/pkg/v3@v3.5.36 go.etcd.io/etcd/client/v3@v3.5.36"
RUN cd /tmp && go mod download github.com/minio/mc@${MC_VERSION} && \
    cp -R "$(go list -m -f '{{.Dir}}' github.com/minio/mc@${MC_VERSION})" /build/mc && \
    chmod -R u+w /build/mc && cd /build/mc && \
    go get ${MC_DEP_UPGRADES} && go mod tidy && \
    GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -ldflags "-s -w" -o /go/bin/mc . && \
    mkdir -p /rootfs/data

# Runtime image: minio and mc are fully static (CGO_ENABLED=0), so they need no
# OS userland. Distroless static carries only CA certs, tzdata and passwd files,
# which removes the unfixable glibc/ncurses/pcre2/... CVEs of the UBI base.
# There is no shell in this image.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5

ARG RELEASE

LABEL name="MinIO" \
      vendor="MinIO Inc <dev@min.io>" \
      maintainer="MinIO Inc <dev@min.io>" \
      version="${RELEASE}" \
      release="${RELEASE}" \
      summary="MinIO is a High Performance Object Storage, API compatible with Amazon S3 cloud storage service." \
      description="MinIO object storage is fundamentally different. Designed for performance and the S3 API, it is 100% open-source. MinIO is ideal for large, private cloud environments with stringent security requirements and delivers mission-critical availability across a diverse range of workloads."

ENV MINIO_ACCESS_KEY_FILE=access_key \
    MINIO_SECRET_KEY_FILE=secret_key \
    MINIO_ROOT_USER_FILE=access_key \
    MINIO_ROOT_PASSWORD_FILE=secret_key \
    MINIO_KMS_SECRET_KEY_FILE=kms_master_key \
    MINIO_UPDATE_MINISIGN_PUBKEY="RWTx5Zr1tiHQLwG9keckT0c45M3AGeHD6IvimQHpyRywVWGbP1aVSGav" \
    MINIO_CONFIG_ENV_FILE=config.env \
    MC_CONFIG_DIR=/tmp/.mc

# The *_FILE variables above are relative paths that minio resolves against the
# working directory. Distroless nonroot defaults to /home/nonroot (mode 0700),
# so any other uid (e.g. a Kubernetes runAsUser) gets EACCES instead of ENOENT
# and minio aborts with "Invalid credentials". Use / like the upstream image.
WORKDIR /

COPY --from=build --chmod=0755 /go/bin/minio /go/bin/mc /usr/bin/
COPY --from=build --chown=65532:65532 /rootfs/data /data

COPY CREDITS /licenses/CREDITS
COPY LICENSE /licenses/LICENSE

EXPOSE 9000
VOLUME ["/data"]

# Same invocation as the upstream image minus the shell wrapper:
#   docker run <image> server /data
ENTRYPOINT ["/usr/bin/minio"]
CMD ["server", "/data"]
